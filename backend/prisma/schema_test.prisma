 generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id              String   @id @default(cuid())
  name            String
  phone           String   @unique
  timezone        String   @default("Europe/Madrid")
  schedule        Json
  plan            String   @default("basic")
  active          Boolean  @default(true)
  bookingCapacity Int      @default(1)
  twilioPhoneNumber            String?   @unique
  twilioPhoneNumberSid         String?   @unique
  twilioPhoneNumberPurchasedAt DateTime?
  twilioPhoneNumberStatus      String?   @default("pending")
  vapiPhoneNumberId            String?   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agents          Agent[]
  calls           Call[]
  services        Service[]
  professionals   Professional[]

  @@map("businesses")
}

model Agent {
  id               String   @id @default(cuid())
  businessId       String
  vapiAssistantId  String?
  name             String
  voice            String   @default("Octave")
  language         String   @default("es")
  systemPrompt     String
  promptVersion    Float?   @default(1)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  firstMessage     String?  @default("Hola, soy tu asistente. ¿En qué puedo ayudarte?")
  firstMessageMode String?  @default("assistant-speaks-first")
  llmModel         String   @default("openai/gpt-oss-120b")
  llmProvider      String   @default("groq")
  llmTemperature   Float?   @default(0.3)
  sttModel         String   @default("nova-2-phonecall")
  sttProvider      String   @default("deepgram")
  voiceId          String   @default("6b530c02-5a80-4e60-bb68-f2c171c5029f")
  voiceModel       String?  @default("octave")
  voiceProvider    String   @default("hume")
  files            Json?
  integrations     Json?
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calls            Call[]

  @@index([businessId])
  @@map("agents")
}

model Service {
  id                String                @id @default(cuid())
  businessId        String
  name              String
  durationMinutes   Int
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalLinks ProfessionalService[]

  @@index([businessId])
  @@map("services")
}

model Professional {
  id           String                @id @default(cuid())
  businessId   String
  name         String
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceLinks ProfessionalService[]

  @@index([businessId])
  @@map("professionals")
}

model ProfessionalService {
  professionalId String
  serviceId      String
  assignedAt     DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
  @@map("professional_services")
}

model Call {
  id           String       @id @default(cuid())
  businessId   String
  agentId      String?
  vapiCallId   String       @unique
  status       CallStatus   @default(IN_PROGRESS)
  outcome      CallOutcome?
  durationSecs Int?
  costCents    Int?
  startedAt    DateTime     @default(now())
  endedAt      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  agent        Agent?       @relation(fields: [agentId], references: [id])
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads        Lead[]
  recording    Recording?
  transcript   Transcript?
  booking      Booking?     // Relación a Booking
  order        Order?       // Relación a Order

  @@index([businessId])
  @@index([agentId])
  @@index([vapiCallId])
  @@map("calls")
}

model Booking {
  id            String    @id @default(cuid())
  callId        String    @unique
  call          Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  programedAt   DateTime    
  numberPeople  Int
  isCancelled   Boolean   @default(false)
}

model Order {
  id               String   @id @default(cuid())
  callId           String   @unique
  call             Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  order            String?
  createdAt        DateTime @default(now())
}

model Transcript {
  id        String   @id @default(cuid())
  callId    String   @unique
  fullText  String
  messages  Json
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

model Recording {
  id          String   @id @default(cuid())
  callId      String   @unique
  vapiUrl     String
  storageKey  String?
  storageUrl  String?
  reviewed    Boolean  @default(false)
  reviewNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("recordings")
}

model Lead {
  id        String   @id @default(cuid())
  callId    String
  type      String
  data      Json
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("leads")
}

enum CallStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  FAILED
  TIMED_OUT
}

enum CallOutcome {
  RESOLVED
  FRUSTRATED
  NO_ANSWER
  ESCALATED
  LEAD_CAPTURED
}
