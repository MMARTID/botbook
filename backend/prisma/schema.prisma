generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id              String  @id @default(cuid())
  name            String
  phone           String  @unique
  timezone        String  @default("Europe/Madrid")
  schedule        Json
  plan            String  @default("basic")
  active          Boolean @default(true)
  systemPrompt    String? @db.Text
  businessDetails String? @db.Text
  agentSettings   Json?
  bookingCapacity Int     @default(1)

  // Restricciones de reserva aplicadas por check_business_hours y
  // book_appointment (voiceTools/service.ts). null = sin restricción.
  minAdvanceBookingMinutes      Int?
  maxAppointmentDurationMinutes Int?

  // Voice orchestrator selection (default Retell for RGPD compliance)
  orchestrator        String  @default("retell")
  retellPhoneNumberId String? @unique
  retellPhoneNumber   String? @unique

  // Enrutamiento Telnyx AI Assistants / failover a Retell (ver
  // PLAN-TELNYX-ORQUESTADOR.md). voiceRoutingTarget es la ruta EFECTIVA de la
  // próxima llamada nueva y puede diferir de `orchestrator` durante un
  // failover; una llamada ya iniciada nunca migra de proveedor.
  voiceRoutingTarget      String    @default("retell")
  voiceFailoverActive     Boolean   @default(false)
  voiceFailoverReason     String?
  voiceRoutingChangedAt   DateTime?
  // Explican por qué un negocio no es elegible para Telnyx (idioma sin
  // validar, voz sin fallback compatible, residencia UE no confirmada) antes
  // de tocar su número — null cuando no aplica ninguna exclusión.
  telnyxEligibilityStatus String?
  telnyxEligibilityReason String?   @db.Text

  // Business niche/type used for agent templates and Retell folder organization
  businessType String @default("other")

  // Stripe Billing is scoped to the business, not an individual user.
  stripeCustomerId               String?             @unique
  stripeSubscriptionId           String?             @unique
  stripePriceId                  String?
  subscriptionStatus             SubscriptionStatus?
  subscriptionCurrentPeriodStart DateTime?
  subscriptionCurrentPeriodEnd   DateTime?
  subscriptionTrialEnd           DateTime?
  subscriptionCancelAtPeriodEnd  Boolean             @default(false)
  // Avisos y suspensión por impago. Se conserva el id de la factura que
  // abrió el plazo para que el pago de otra factura no reactive el servicio
  // por error.
  paymentFailureInvoiceId        String?
  paymentFailureNotifiedAt       DateTime?
  paymentFailureSuspensionAt     DateTime?
  callsSuspendedAt               DateTime?
  cancellationNoticeSentAt       DateTime?
  // Los clientes existentes empiezan a facturar excedentes en el siguiente
  // periodo para recibir el aviso antes de cualquier cargo.
  usageBillingStartsAt           DateTime?
  // Timestamp (evento Stripe `created`) del último customer.subscription.*
  // aplicado con éxito — permite descartar un evento entregado fuera de
  // orden (más antiguo que el ya aplicado) en vez de sobrescribir el estado
  // real con uno obsoleto.
  subscriptionEventCreatedAt     DateTime?

  // Estado del ciclo de vida del número de teléfono, independiente de qué
  // proveedor lo gestione (hoy solo Telnyx).
  phoneNumberStatus String? @default("pending")

  // Telnyx Phone Number — proveedor activo para la compra de números de
  // España. telnyxNumberOrderId se persiste nada más crear el pedido
  // (asíncrono en Telnyx) para poder reanudarlo en un reintento sin duplicar
  // la compra.
  // Número elegido y apuntado ANTES de pedirlo a Telnyx. Si el proceso muere
  // entre la compra y el guardado del pedido, el reintento mira aquí y adopta
  // el número que ya se compró en vez de comprar (y facturar) otro.
  telnyxPendingPhoneNumber     String?
  telnyxNumberOrderId          String?   @unique
  telnyxPhoneNumber            String?   @unique
  telnyxPhoneNumberId          String?   @unique
  telnyxPhoneNumberPurchasedAt DateTime?

  // Calendario: la conexión vive en CalendarConnection (una fila por
  // proveedor); esto es solo el puntero al proveedor activo.
  calendarProvider    String?

  // Marca de la última semana resumida por email. Cloud Scheduler entrega al
  // menos una vez, así que el job reclama la semana con un updateMany
  // condicional sobre este campo antes de encolar el correo: sin él, una
  // segunda entrega mandaba el resumen dos veces.
  weeklySummarySentAt DateTime?

  // WhatsApp del dueño (PLAN-CANAL-DUENO.md § 2): el móvil desde el que el
  // dueño escribe a Alhabla y al que le llegan los avisos. No es
  // `Business.phone` (el fijo del local, de Google Places). Lo rellena el
  // alta por WhatsApp (fase 1); el webhook entrante lo usa para saber si
  // quien escribe al número de negocios es un dueño.
  ownerWhatsappNumber String?
  // Preferencias de avisos por WhatsApp (PLAN-CANAL-DUENO.md § 4):
  // `{ avisoPorReserva?: boolean }`; ausente = activado. Ver
  // modules/whatsapp/avisosNegocio.ts.
  notificationPrefs   Json?

  // Alta del dueño por WhatsApp (PLAN-CANAL-DUENO.md § 2, § 6, § 12).
  // El consentimiento tiene que ser demostrable: cuándo, por qué vía y con
  // qué mensaje (la fila de InboundMessage conserva el payload de Meta).
  ownerWhatsappOptInAt          DateTime?
  /// "boton_plantilla" | "alta_codigo" | "alta_palabra" (esta última solo
  /// como REACTIVACIÓN tras un STOP; nunca como primer consentimiento).
  ownerWhatsappOptInVia         String?
  /// InboundMessage.id del mensaje que dio el consentimiento.
  ownerWhatsappOptInMessageId   String?
  // STOP/BAJA desde el móvil. La prueba está en WhatsappOptOut. Se limpia
  // solo cuando ese mismo móvil vuelve a dar el consentimiento.
  ownerWhatsappOptOutAt         DateTime?
  // Error 131026 de Meta (el número no tiene WhatsApp), que llega en
  // diferido como fallo de entrega. Se limpia al cambiar el número, al
  // entregarse cualquier mensaje o al recibir uno desde ese móvil.
  ownerWhatsappUnreachableAt    DateTime?
  // Último envío de bienvenida_negocio: freno de «Reenviar activación».
  // Se reclama ANTES de enviar con un updateMany condicional (atómico).
  ownerWhatsappActivationSentAt DateTime?
  // Fin de la ventana de 24 h abierta por el último mensaje del dueño
  // (receivedAt + 24 h). El PR 3 elige interactivo o plantilla con esto.
  ownerWindowOpenUntil          DateTime?
  // Código de «ALTA <código>»: 6 símbolos de ABCDEFGHJKLMNPQRSTUVWXYZ23456789
  // (sin 0/O/1/I), crypto.randomBytes, único entre negocios, caduca a los
  // 7 días y se anula con CUALQUIER opt-in (código, botón o reactivación).
  ownerAltaCode                 String?   @unique
  ownerAltaCodeExpiresAt        DateTime?

  // Id de Google Places del local; alimenta el sufijo del botón URL «Cómo
  // llegar» de confirmacion_cita_v2. Solo [A-Za-z0-9_-], lo valida
  // PATCH /business/me (y otra vez placeIdValido al enviar).
  placeId             String?
  // Dirección formateada de Places; informativa, no va en ninguna plantilla
  // en este PR.
  address             String?

  // Fase 2 (conversaciones Beta, PLAN-CANAL-DUENO.md § 7 y § 8). Los dos
  // interruptores por negocio están por debajo de los globales
  // TELNYX_CLIENT_CHAT_ENABLED / TELNYX_OWNER_CHAT_ENABLED: con el global
  // apagado no chatea nadie aunque aquí siga a true.
  clientChatEnabled          Boolean   @default(true)
  ownerChatEnabled           Boolean   @default(true)
  // Conversación del dueño con el Gestor único (Telnyx `ai.conversations`),
  // creada por Alhabla con metadata { business_id, role: "owner" }. Rota a
  // los 30 días o con BAJA. Se usa desde el PR del Gestor.
  ownerConversationId        String?
  ownerConversationCreatedAt DateTime?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  agents              Agent[]
  calls               Call[]
  services            Service[]
  professionals       Professional[]
  stripeWebhookEvents StripeWebhookEvent[]
  billingUsagePeriods BillingUsagePeriod[]
  onboardingState     OnboardingState?
  calendarConnections CalendarConnection[]
  clientConversations ClientConversation[]

  @@index([ownerWhatsappNumber])
  @@map("businesses")
}

/// Chat de un cliente con la recepcionista de un negocio por WhatsApp
/// (fase 2, § 7): una conversación de Telnyx por cliente y negocio, contra
/// el mismo assistant que atiende la llamada. `callId` es la Call sintética
/// `whatsapp:chat:<id>` que las tools de voz resuelven: la conversación
/// lleva `call_control_id` en sus metadata y Telnyx lo templa en la cabecera
/// X-Alhabla-Call-Control-Id de las tools (verificado en dev el 2026-09-20).
model ClientConversation {
  id             String    @id @default(cuid())
  businessId     String
  /// Móvil del cliente en E.164 (el `from` de WhatsApp).
  clientPhone    String
  /// Id de la conversación en Telnyx. Cambia al rotar (30 días).
  conversationId String    @unique
  /// `Call.callId` de la Call sintética de este hilo (`whatsapp:chat:<id>`).
  callId         String    @unique
  /// Fecha de creación de la conversación de Telnyx vigente (rotación).
  startedAt      DateTime  @default(now())
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  /// Turnos atendidos por el LLM en este hilo (informativo).
  turns          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, clientPhone])
  @@map("client_conversations")
}

model BillingUsagePeriod {
  id                 String               @id @default(cuid())
  businessId         String
  periodStart        DateTime
  periodEnd          DateTime
  reportedMinutes    Int                  @default(0)
  warningEmailSentAt DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reports            BillingUsageReport[]

  @@unique([businessId, periodStart])
  @@index([periodEnd])
  @@map("billing_usage_periods")
}

model BillingUsageReport {
  id         String             @id @default(cuid())
  periodId   String
  minutes    Int
  identifier String             @unique
  reportedAt DateTime?
  lastError  String?            @db.Text
  createdAt  DateTime           @default(now())
  period     BillingUsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, reportedAt])
  @@map("billing_usage_reports")
}

// Conexión de un negocio con un proveedor de calendario (Google, Outlook y,
// en el futuro, CalDAV). Una fila por proveedor y negocio; el proveedor
// activo lo señala Business.calendarProvider. Solo la lee y escribe
// modules/calendar/conexion.ts.
model CalendarConnection {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// "google" | "outlook" | "caldav" (CalendarProviderId). String y no enum
  /// para que añadir un proveedor no exija migración.
  provider       String
  /// Calendario elegido dentro de la cuenta. null = aún no se eligió (Outlook
  /// tras el OAuth y CalDAV tras el alta, antes del selector); Google usa
  /// "primary" por defecto. En CalDAV es la URL absoluta del calendario.
  calendarId     String?
  /// Credenciales con la misma forma que CalendarCredentials (p. ej.
  /// { provider: "google", refreshToken } o { provider: "caldav", serverUrl,
  /// username, appPassword }), cifradas en reposo (lib/cifradoDeCredenciales).
  /// null = revocadas (invalid_grant o 401 de CalDAV): hace falta reconectar.
  credentials    Json?
  connected      Boolean   @default(false)
  disconnectedAt DateTime?
  lastError      String?   @db.Text
  /// Email de la cuenta conectada cuando el proveedor lo da: Outlook (cuenta
  /// de Graph) y CalDAV (el Apple ID con el que se autenticó).
  accountEmail   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([businessId, provider])
  @@map("calendar_connections")
}

model OnboardingState {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  dismissedAt           DateTime?
  completedAt           DateTime?
  // El desvío se activa en el terminal del negocio, fuera de nuestro alcance:
  // no hay forma de comprobarlo por API. Se da por hecho cuando entra la
  // primera llamada real; hasta entonces, esto guarda que el usuario dijo
  // haberlo activado.
  forwardingConfirmedAt DateTime?
  steps                 Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

model StripeWebhookEvent {
  id                  String    @id
  businessId          String?
  type                String
  createdAt           DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastError           String?   @db.Text
  business            Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([type])
  @@map("stripe_webhook_events")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  googleId        String?   @unique
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Prueba de aceptación de Términos y Condiciones / Política de privacidad
  // en el registro — null en usuarios creados antes de exigirlo.
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([businessId])
  @@map("users")
}

model Agent {
  id                   String    @id @default(cuid())
  businessId           String
  retellAgentId        String?   @unique
  retellLlmId          String?
  name                 String
  voice                String    @default("Octave")
  language             String    @default("es")
  systemPrompt         String
  promptVersion        Float?    @default(1)
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  firstMessage         String?   @default("Hola, soy tu asistente. ¿En qué puedo ayudarte?")
  firstMessageMode     String?   @default("assistant-speaks-first")
  llmModel             String    @default("openai/gpt-oss-20b")
  llmProvider          String    @default("groq")
  llmTemperature       Float?    @default(0.3)
  sttModel             String    @default("nova-2")
  sttProvider          String    @default("deepgram")
  voiceId              String    @default("538a8872-3799-4df5-b373-b78493b766c6")
  voiceModel           String?   @default("sonic-3.5")
  voiceProvider        String    @default("cartesia")
  integrations         Json?
  // true una vez que PATCH /agents/:id edita systemPrompt a mano — a partir
  // de ahí syncAgentToRetell debe dejar de reconstruir y sobrescribir el
  // prompt de este agente cuando cambien servicios/profesionales/ajustes.
  promptManuallyEdited Boolean   @default(false)
  // Un agente conserva sus llamadas y su configuración remota para poder
  // auditar su historial. Al eliminarlo desde el panel se desactiva y se
  // oculta, pero nunca se borra físicamente junto a esas llamadas.
  deletedAt            DateTime?

  // Sincronización Telnyx AI Assistants — fallback caliente de Retell hasta
  // que el negocio entre en rollout Telnyx (ver PLAN-TELNYX-ORQUESTADOR.md).
  telnyxAssistantId String?   @unique
  telnyxConfigHash  String?
  telnyxSyncedAt    DateTime?
  telnyxSyncError   String?   @db.Text
  // Mismos campos para Retell, antes inexistentes: sin ellos el reconciliador
  // no puede tratar ambos proveedores de forma simétrica.
  retellConfigHash  String?
  retellSyncedAt    DateTime?
  retellSyncError   String?   @db.Text

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calls    Call[]

  @@index([businessId])
  @@index([businessId, deletedAt])
  @@index([retellAgentId])
  @@map("agents")
}

model Service {
  id                String                @id @default(cuid())
  businessId        String
  name              String
  durationMinutes   Int
  // Precio en céntimos, opcional: un negocio puede trabajar sin tarifa
  // publicada. Cuando está, el panel puede estimar los ingresos de las citas
  // reservadas sin inventar una tarifa cuando el negocio no la ha fijado.
  priceCents        Int?
  active            Boolean               @default(true)
  // Las citas históricas guardan los IDs de los servicios. El borrado lógico
  // permite seguir resolviendo su nombre y precio original en el historial.
  deletedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalLinks ProfessionalService[]

  @@index([businessId])
  @@index([businessId, deletedAt])
  @@map("services")
}

model Professional {
  id           String                @id @default(cuid())
  businessId   String
  name         String
  active       Boolean               @default(true)
  // Las citas históricas conservan la relación con el profesional aunque ya
  // no trabaje en el negocio.
  deletedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceLinks ProfessionalService[]
  bookings     Booking[]

  @@index([businessId])
  @@index([businessId, deletedAt])
  @@map("professionals")
}

// Nivel de un profesional en un servicio concreto. No hay fila para el caso
// normal ("lo hace"): solo se guardan los dos extremos.
// - ESPECIALISTA: se lleva la cita cuando el cliente no pide a nadie, y el
//   agente puede decirlo en positivo al confirmar.
// - NO_SUGERIR (aprendiz, recepcionista, "no se le da bien"): nunca se asigna
//   sola; si el cliente la pide por su nombre, el agente recomienda una vez a
//   quien mejor lo hace y, si insiste, reserva con quien pidió. Es un
//   concepto interno del panel: jamás se le dice al cliente.
enum ProfessionalServiceLevel {
  ESPECIALISTA
  NO_SUGERIR
}

model ProfessionalService {
  professionalId String
  serviceId      String
  // Las filas anteriores a este campo eran la casilla "especialidad" del
  // panel: conservan ese significado con el valor por defecto.
  level          ProfessionalServiceLevel @default(ESPECIALISTA)
  assignedAt     DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
  @@map("professional_services")
}

model Call {
  id                     String                @id @default(cuid())
  businessId             String
  agentId                String?
  callId                 String                @unique
  fromNumber             String?
  status                 CallStatus            @default(IN_PROGRESS)
  outcome                CallOutcome?
  sentiment              CallSentiment?
  summary                String?               @db.Text
  successful             Boolean?
  // Los tres campos siguientes ya los calculaba Retell en cada llamada y se
  // descartaban al parsear el webhook. Responden al «por qué no se reservó»,
  // que es la pregunta que el negocio se hace ante una llamada sin cita.
  escalationReason       CallEscalationReason?
  toolFailureDetected    Boolean?
  // Nombre del servicio pedido. No es enum: las opciones se generan con los
  // servicios reales de cada negocio (buildRequestedServiceAnalysisField), así
  // que el valor solo tiene sentido dentro de ese negocio.
  requestedService       String?
  durationSecs           Int?
  costCents              Int?
  // Proveedor real que atendió la llamada y su ID nativo. callId se
  // mantiene poblado en paralelo por compatibilidad (índices, joins ya
  // existentes en el resto del esquema) hasta migrarlo por completo a estos
  // campos genéricos — ver PLAN-TELNYX-ORQUESTADOR.md § "Cambios de datos".
  voiceProvider          String                @default("retell")
  // Informe que la recepcionista manda con la tool informar_al_negocio al
  // terminar la llamada (post-conversación de Telnyx, PLAN-CANAL-DUENO.md
  // § 10): resultado, motivo de escalada, fallo de tool, servicio pedido y
  // recado. Se guarda el PRIMER informe (Telnyx lo manda dos veces); si el
  // segundo trae recado y el primero no, se añade. Convive con los insights
  // (doble escritura) hasta medir la concordancia.
  postCallReport         Json?
  postCallReportAt       DateTime?
  providerCallId         String?
  providerConversationId String?
  // OJO: en Telnyx, providerCostCents viene del webhook call.cost y SOLO
  // cubre telefonía (sip-trunking, call-control, grabación) — el coste de
  // IA (LLM+STT+TTS) se factura aparte como producto ai-voice-assistant y
  // NO llega en este webhook (confirmado 2026-09-12 comparando contra
  // usageReports: en una llamada real de 126s, 3 céntimos aquí vs 17.52
  // céntimos reales con IA incluida). providerCostBreakdown guarda los
  // cost_parts de telefonía tal cual llegan; no incluye IA.
  providerCostCents      Int?
  providerCostBreakdown  Json?
  startedAt              DateTime              @default(now())
  endedAt                DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  agent                  Agent?                @relation(fields: [agentId], references: [id])
  business               Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads                  Lead[]
  recording              Recording?
  transcript             Transcript?
  booking                Booking?
  order                  Order?
  voiceWebhookEvents     VoiceWebhookEvent[]

  @@unique([voiceProvider, providerCallId])
  @@index([businessId])
  @@index([agentId])
  // Compuestos que sirven a las consultas reales: el listado del panel ordena
  // por createdAt dentro del negocio, y analítica, facturación, resumen
  // semanal y estadísticas filtran por rango de startedAt. Con solo
  // [businessId], Postgres ordenaba todo el historial del negocio en cada
  // petición. El de status cubre el heurístico de la llamada en curso y el
  // barrido de llamadas zombi, que antes recorría la tabla entera cada 15 min.
  @@index([businessId, startedAt])
  @@index([businessId, createdAt])
  @@index([businessId, status, startedAt])
  @@index([status, updatedAt])
  @@map("calls")
}

/**
 * Idempotencia de webhooks de voz (Telnyx y, más adelante, Retell) — evita
 * duplicar grabaciones, insights, outcomes y trabajos de Cloud Tasks cuando
 * un proveedor reintenta la entrega del mismo evento.
 */
model VoiceWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  callId      String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      String?
  lastError   String?   @db.Text
  call        Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([callId])
  @@map("voice_webhook_events")
}

model Booking {
  id                       String        @id @default(cuid())
  callId                   String        @unique
  call                     Call          @relation(fields: [callId], references: [id], onDelete: Cascade)
  professionalId           String?
  professional             Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  // Uno o varios servicios pedidos en la misma reserva (ej. "corte y
  // mechas") — sin relación de Prisma a Service (array nativo de Postgres,
  // no una tabla puente): resolver los nombres necesita una consulta aparte
  // con `in: serviceIds`. Se elige este diseño en vez de una tabla
  // BookingService porque aquí "servicio pedido" es solo un dato de la
  // reserva, nunca algo que se consulte desde el otro lado (Service no
  // necesita saber en qué reservas aparece).
  serviceIds               String[]      @default([])
  // Nombre con el que se hizo la reserva — antes solo vivía en el título del
  // evento de calendario, así que find_my_appointment no podía devolverlo y
  // el agente de voz no tenía forma de conservar el nombre al recrear una
  // cita ("cámbiala al mismo nombre"). Nullable: las reservas anteriores a
  // esta columna no lo tienen.
  clientName               String?
  // Solo se rellena si el cliente pidió usar un número distinto al de la
  // llamada (Call.fromNumber) — si es el mismo, no hace falta guardarlo aquí.
  clientPhone              String?
  // ID del evento en Google Calendar/Outlook, generado de forma determinista
  // a partir de callId (ver bookAppointment en calendar/service.ts) — permite
  // que un reintento (retry de Cloud Tasks, fallo de red tras crear el
  // evento) reutilice el mismo evento externo en vez de crear uno duplicado.
  externalEventId          String?
  // Calendario que creó el evento externo. Sin este origen, al cambiar el
  // negocio de calendario se podía interpretar que una cita seguía anulada
  // solo porque su evento no existe en el calendario recién seleccionado.
  externalCalendarProvider String?
  externalCalendarId       String?
  createdAt                DateTime      @default(now())
  programedAt              DateTime
  durationMinutes          Int           @default(30)
  numberPeople             Int
  isCancelled              Boolean       @default(false)
  // Consentimiento explícito del cliente (dado por voz durante la reserva)
  // para usar el número de esta cita en la confirmación y el recordatorio
  // por SMS. También es la puerta de entrada para que una llamada futura
  // desde ese mismo número pueda localizar/cancelar la cita por voz — ver
  // find_my_appointment/cancel_appointment en voiceTools/service.ts.
  smsConsent               Boolean       @default(false)
  // Quién y cuándo canceló (`client_voice`, `client_button`, `owner_chat`,
  // `system`); las cancelaciones anteriores a estas columnas no lo tienen.
  cancelledAt              DateTime?
  cancelledBy              String?
  // Botón «Confirmo» del recordatorio por WhatsApp; se escribe una sola vez
  // (updateMany con confirmedByClientAt: null).
  confirmedByClientAt      DateTime?
  // "voice" | "whatsapp_lista_espera" | "owner_chat" (fase 2). Null en las
  // reservas anteriores a esta columna = voz.
  createdVia               String?
  // Cuándo salió de verdad la confirmación al cliente: la pone el job
  // send-whatsapp al enviar, o la respuesta de «Sí, resérvala» cuando sale.
  // Se limpia si Meta devuelve failed en diferido. Null = no se le mandó
  // nada (sin consentimiento, sin número, baja, fallo).
  clientNotifiedAt         DateTime?

  @@index([professionalId])
  @@index([externalCalendarProvider, externalCalendarId])
  // La disponibilidad (camino crítico de una llamada de voz), la agenda del
  // panel y el resumen semanal filtran y ordenan por estas fechas; hasta
  // ahora ninguna tenía índice.
  @@index([programedAt])
  @@index([createdAt])
  @@map("bookings")
}

model Order {
  id        String   @id @default(cuid())
  callId    String   @unique
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  order     String?
  createdAt DateTime @default(now())

  @@map("orders")
}

model Transcript {
  id        String   @id @default(cuid())
  callId    String   @unique
  fullText  String
  messages  Json
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

model Recording {
  id          String    @id @default(cuid())
  callId      String    @unique
  externalUrl String
  storageKey  String?
  storageUrl  String?
  reviewed    Boolean   @default(false)
  reviewNotes String?
  // La URL que llega en el webhook de Telnyx caduca a los 10 minutos. Con el
  // leg se le puede pedir una nueva (GET /v2/recordings?filter[call_leg_id])
  // en vez de dar la grabación por perdida si el primer intento no llegó a
  // tiempo. Retell no lo necesita: sus URLs no caducan.
  providerLegId       String?
  // Marca de "irrecuperable": el proveedor ya no tiene el audio (o nunca lo
  // tuvo). retryStuckRecordings deja de reencolarla y el motivo queda para el
  // panel. Sin esto, 50 grabaciones caducadas reintentaban cada 15 min para
  // siempre (~8.000 peticiones al día a un 403).
  processingFailedAt  DateTime?
  processingError     String?
  // La revisión o retirada desde el panel no destruye de inmediato un dato
  // histórico. Las políticas de retención se encargan de la purga física.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  call        Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([createdAt])
  // retryStuckRecordings barre cada 15 min las grabaciones sin subir.
  @@index([storageKey, deletedAt])
  @@map("recordings")
}

model Lead {
  id         String    @id @default(cuid())
  callId     String
  type       String
  data       Json
  isLead     Boolean   @default(false)
  // Se marca cuando un reintento en segundo plano (jobs/retryFailedBooking.ts)
  // confirma una reserva que había fallado durante la llamada.
  resolvedAt DateTime?
  // Aviso al negocio de esta cita pendiente (WhatsApp o email): cuándo y por
  // qué vía (`interactivo`, `plantilla`, `email`, o `ninguna:<motivo>`).
  notifiedAt  DateTime?
  notifiedVia String?
  // «Recuérdamelo mañana» en el aviso de un recado: hasta cuándo se pospone
  // (el job recordar-recado lo vuelve a avisar si sigue sin resolver).
  snoozedUntil DateTime?
  createdAt  DateTime  @default(now())
  call       Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  // El contador de citas pendientes del panel y el listado de leads filtran
  // por tipo y por si están resueltos.
  @@index([type, resolvedAt])
  @@index([createdAt])
  @@map("leads")
}

/**
 * Mensajes ya enviados (email, SMS y WhatsApp), reclamados por inserción
 * antes de salir. Cloud Tasks entrega AL MENOS UNA VEZ: sin esto, un envío
 * que tardaba más que el plazo de la tarea se reintentaba y el cliente
 * recibía dos veces la misma confirmación (o el mismo resumen semanal).
 */
model SentMessage {
  id             String   @id @default(cuid())
  /**
   * "email" | "sms" | "whatsapp"
   */
  channel        String
  /**
   * Clave determinista del envío, la misma que el id de la tarea. Los envíos
   * de WhatsApp hechos fuera de un job (respuestas del webhook, scripts) usan
   * `adhoc:<id del mensaje en Telnyx>`.
   */
  idempotencyKey String
  sentAt         DateTime @default(now())

  // Entrega y coste de los mensajes de WhatsApp (PLAN-CANAL-DUENO.md
  // § SentMessage). Todo opcional: las filas de email/SMS y las anteriores a
  // esta columna solo tienen channel + idempotencyKey. `providerMessageId`
  // es el id del mensaje en Telnyx, y es lo que trae `context.id` cuando el
  // destinatario responde a un botón — la correlación botón → recurso pasa
  // por aquí (verificado en la fase 0.1).
  providerMessageId String?   @unique
  businessId        String?
  /** "client" | "owner" — a qué remitente de Alhabla pertenece el envío. */
  audience          String?
  fromNumber        String?
  toNumber          String?
  /** "template" | "text" | "interactive" | "contacts" */
  kind              String?
  templateName      String?
  templateLanguage  String?
  /** `biz_opaque_callback_data`: vuelve en los `statuses[]` de Meta. */
  callbackData      String?
  /** Último estado conocido: queued | sent | delivered | read | failed */
  deliveryStatus    String?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  errorCode         String?
  errorDetail       String?   @db.Text
  /** Coste en USD con cuatro decimales, tal como lo informa Telnyx. */
  costAmount        Decimal?  @db.Decimal(10, 5)
  costCurrency      String?

  @@unique([channel, idempotencyKey])
  @@index([sentAt])
  @@index([businessId, sentAt])
  @@index([toNumber, sentAt])
  @@map("sent_messages")
}

/**
 * Remitentes de WhatsApp de Alhabla, uno por audiencia (PLAN-CANAL-DUENO.md
 * § 1): `client` («Alhabla Reservas», +34 930 454 394) para todo lo que va
 * al cliente y `owner` («Alhabla», +34 930 453 218) para todo lo que va al
 * negocio. Fuente de verdad de qué número usa cada envío; la variable
 * `WHATSAPP_TELNYX_FROM_NUMBER` queda solo como respaldo cuando la tabla
 * está vacía. Se rellena con `scripts/manual/sincronizarWhatsapp.mts` a
 * partir del WABA.
 */
model WhatsappSender {
  id                  String    @id @default(cuid())
  /** "client" | "owner" */
  audience            String    @unique
  /** E.164, p.ej. "+34930454394". */
  phoneNumber         String    @unique
  telnyxPhoneNumberId String?
  /** `phone_number_id` de Meta, el que llega en `metadata` del webhook. */
  metaPhoneNumberId   String?
  displayName         String?
  displayNameStatus   String?
  /** Estado en el WABA tal como lo informa Telnyx: CONNECTED, PENDING… */
  status              String
  qualityRating       String?
  messagingLimit      String?
  /** Versión del perfil (about, descripción, foto) aplicada por el script. */
  profileVersion      Int       @default(0)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("whatsapp_senders")
}

/**
 * Plantillas de WhatsApp del WABA de Alhabla, sincronizadas desde Telnyx
 * (script) y mantenidas al día por los webhooks `whatsapp.template.*`.
 * `key` es el uso que le da el código ("confirmacion_cita",
 * "nueva_reserva_negocio"…): una sola fila por uso, asignada por el script.
 * Sustituye a las variables `WHATSAPP_TEMPLATE_*_NAME`, que quedan como
 * respaldo mientras la tabla no tenga la plantilla.
 */
model WhatsappTemplate {
  id               String    @id @default(cuid())
  key              String?   @unique
  name             String
  language         String
  /** UUID de Telnyx — es por lo que se envía SIEMPRE (por nombre + idioma
   * `es_ES` Meta devuelve 40008; verificado el 19-09). */
  telnyxTemplateId String    @unique
  metaTemplateId   String?
  /** UTILITY | MARKETING | AUTHENTICATION */
  category         String
  /** APPROVED | PENDING | REJECTED | PAUSED | DISABLED | PENDING_DELETION */
  status           String
  qualityRating    String?
  rejectionReason  String?   @db.Text
  components       Json?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([name, language])
  @@map("whatsapp_templates")
}

/**
 * Mensajes entrantes de WhatsApp (evento `whatsapp.messages` del webhook del
 * WABA, formato Meta). Una fila por `messages[].id`: la unicidad de
 * `providerMessageId` es la idempotencia del entrante, además de la del
 * evento (VoiceWebhookEvent). Guarda el payload completo para no perder
 * nada mientras los handlers de la fase 1 se van añadiendo.
 */
model InboundMessage {
  id                String    @id @default(cuid())
  /** `messages[].id` (UUID de Telnyx). */
  providerMessageId String    @unique
  /** `messages[].foreign_id` (`wamid…` de Meta). */
  foreignId         String?
  eventId           String?
  fromNumber        String
  /** Número de Alhabla que recibe, en E.164. */
  toNumber          String
  /** "client" | "owner" | null si el número receptor no es un remitente conocido. */
  audience          String?
  /** "owner" | "client" | "unknown" — quién escribe, según la BD. */
  role              String
  businessId        String?
  /** "text" | "button" | "keyword" | "audio" | "media" | "other" */
  kind              String
  text              String?   @db.Text
  buttonId          String?
  buttonTitle       String?
  /** `context.id`: id del mensaje saliente al que responde (botón o cita). */
  contextMessageId  String?
  contactName       String?
  payload           Json
  receivedAt        DateTime
  handledAt         DateTime?
  handler           String?
  error             String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([fromNumber, receivedAt])
  @@index([businessId, receivedAt])
  @@index([contextMessageId])
  /// Barrido de filas sin enrutar (proceso muerto entre guardar y enrutar).
  @@index([handledAt, receivedAt])
  @@map("inbound_messages")
}

/**
 * Bajas de WhatsApp por número y audiencia (PLAN-CANAL-DUENO.md § 6.1). Un
 * STOP al número de clientes es GLOBAL para ese móvil (todos los negocios);
 * un STOP al de negocios deja además ownerWhatsappOptOutAt en cada negocio
 * con ese móvil. La consultan TODOS los envíos del servicio antes de salir.
 * Baja vigente ⇔ revokedAt IS NULL. Al escribir ALTA se conserva la fila con
 * revokedAt (historial demostrable). No se borra nunca, ni al borrar la
 * cuenta: es la voluntad de una persona, no un dato del tenant.
 */
model WhatsappOptOut {
  id                 String    @id @default(cuid())
  /** E.164 del móvil que pidió la baja. */
  phoneNumber        String
  /** "client" | "owner": a qué número de Alhabla escribió. */
  audience           String
  optedOutAt         DateTime
  /** "STOP" | "BAJA": la palabra exacta que escribió. */
  keyword            String
  /** InboundMessage.id del STOP (prueba). */
  inboundMessageId   String?
  /** Negocio con el que se le identificó en ese momento (informativo). */
  businessId         String?
  revokedAt          DateTime?
  /** InboundMessage.id del ALTA que la revocó. */
  revokedByMessageId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([phoneNumber, audience])
  @@map("whatsapp_opt_outs")
}

enum CallStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  FAILED
  TIMED_OUT
}

enum CallOutcome {
  RESOLVED
  FRUSTRATED
  NO_ANSWER
  ESCALATED
  LEAD_CAPTURED
}

enum CallSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

/**
 * Motivo por el que una llamada acabó escalada o con una reserva sin
 * completar. Lo clasifica Retell en post_call_analysis_data — ver
 * ESCALATION_REASON_FIELD en lib/agentBootstrap.ts, que define estas mismas
 * opciones; si se cambian ahí, hay que cambiarlas aquí.
 */
enum CallEscalationReason {
  CLIENTE_LO_PIDIO
  FALLO_TECNICO
  FUERA_DE_HORARIO
  CONSULTA_COMPLEJA
  NO_APLICA
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}
