exports[`payloads de asistentes (instantáneas) > assistant de la recepcionista, completo con transferencia y palabras clave 1`] = `
{
  "fallbackConfig": {
    "model": "moonshotai/Kimi-K2.6",
  },
  "greeting": "Peluquería Ana, dígame.",
  "insightGroupId": undefined,
  "instructions": "Hola Peluquería Ana, llama {{telnyx_end_user_target}} a las {{telnyx_current_time_Europe/Madrid}} (Europe/Madrid).",
  "interruptionSettings": {
    "interrupt_prediction_threshold": 0.4,
    "start_speaking_plan": {
      "wait_seconds": 0.1,
    },
  },
  "model": "openai/gpt-5.6-luna",
  "name": "alhabla-neg_1-ag_1",
  "postConversationSettings": {
    "enabled": true,
  },
  "privacySettings": {
    "data_retention": true,
  },
  "telephonySettings": {
    "noise_suppression": "disabled",
    "recording_settings": {
      "channels": "dual",
      "enabled": true,
      "format": "wav",
      "stop_on_conversation_end": true,
    },
    "send_conversation_message_events": true,
    "time_limit_secs": 600,
    "user_idle_reply_secs": 12,
    "user_idle_timeout_secs": 30,
  },
  "tools": [
    {
      "timeout_ms": 20000,
      "type": "webhook",
      "webhook": {
        "body_parameters": {
          "properties": {},
          "required": undefined,
          "type": "object",
        },
        "description": "Única fuente de lo que ofrece el negocio: los servicios activos con sus IDs y duraciones, los profesionales y el horario. Llámala antes de confirmar o negar un servicio, un profesional o el horario, también ante una pregunta de sí o no, y antes de comprobar o reservar si necesitas un ID o una duración.",
        "headers": [
          {
            "name": "X-Alhabla-Call-Control-Id",
            "value": "{{call_control_id}}",
          },
        ],
        "method": "POST",
        "name": "get_catalog",
        "url": "https://api.alhabla.test/webhooks/telnyx/tools/get_catalog",
      },
    },
    {
      "timeout_ms": 20000,
      "type": "webhook",
      "webhook": {
        "body_parameters": {
          "properties": {
            "durationMinutes": {
              "description": "Duración total de la cita en minutos.",
              "type": "number",
            },
            "professionalConfirmed": {
              "description": "true SOLO si ya propusiste una vez a la persona que recomendó la herramienta y el cliente insistió en la que pidió por su nombre. Nunca lo envíes en la primera comprobación.",
              "type": "boolean",
            },
            "professionalId": {
              "description": "ID exacto copiado tal cual de get_catalog, solo si el cliente pidió a un profesional concreto por su nombre (opcional). Déjalo vacío si no lo nombró: nunca elijas tú a nadie.",
              "type": "string",
            },
            "serviceIds": {
              "description": "IDs de los servicios pedidos, copiados exactamente de get_catalog carácter a carácter (opcional; puede ser más de uno si el cliente pide varios servicios en la misma cita, ej. corte y mechas). Se prioriza al profesional que domine todos esos servicios.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "startDateTime": {
              "description": "Inicio solicitado en formato ISO 8601, en HORA LOCAL del negocio con su offset explícito (ej. 2026-09-18T16:00:00+02:00). Nunca en UTC (+00:00/Z): las cuatro de la tarde son 16:00 con el offset local.",
              "type": "string",
            },
          },
          "required": [
            "startDateTime",
            "durationMinutes",
          ],
          "type": "object",
        },
        "description": "Comprueba una cita en una fecha y hora concretas: valida horario, restricciones, capacidad, profesionales y calendario real. Úsala antes de book_appointment y conserva el availabilityToken que devuelve. Si el cliente no pide a nadie, no envíes professionalId: el sistema asigna a quien mejor hace el servicio y lo devuelve en assignedProfessional. Si devuelve recommendation, propón UNA vez a esa persona siguiendo sus instructions.",
        "headers": [
          {
            "name": "X-Alhabla-Call-Control-Id",
            "value": "{{call_control_id}}",
          },
        ],
        "method": "POST",
        "name": "check_availability",
        "url": "https://api.alhabla.test/webhooks/telnyx/tools/check_availability",
      },
    },
    {
      "timeout_ms": 20000,
      "type": "webhook",
      "webhook": {
        "body_parameters": {
          "properties": {
            "availabilityToken": {
              "description": "Token exacto devuelto por check_availability para la opción confirmada.",
              "type": "string",
            },
            "clientEmail": {
              "description": "El correo electrónico del cliente, si lo proporciona (opcional)",
              "type": "string",
            },
            "clientName": {
              "description": "El nombre del cliente que hace la reserva",
              "type": "string",
            },
            "clientPhone": {
              "description": "Teléfono de contacto solo si el cliente eligió uno distinto al detectado automáticamente (opcional).",
              "type": "string",
            },
            "professionalConfirmed": {
              "description": "true SOLO si check_availability devolvió una recomendación, la propusiste una vez y el cliente insistió en la persona que pidió. Sin esto, la reserva se frena hasta que lo hayas propuesto.",
              "type": "boolean",
            },
            "smsConsent": {
              "description": "true si el cliente confirmó por voz que puedes enviarle la confirmación (y un recordatorio) por SMS a este número; false si dijo que no o no se le preguntó.",
              "type": "boolean",
            },
          },
          "required": [
            "clientName",
            "availabilityToken",
          ],
          "type": "object",
        },
        "description": "Agenda una cita en el calendario activo. Úsala solo tras confirmación explícita y con el availabilityToken de check_availability.",
        "headers": [
          {
            "name": "X-Alhabla-Call-Control-Id",
            "value": "{{call_control_id}}",
          },
        ],
        "method": "POST",
        "name": "book_appointment",
        "url": "https://api.alhabla.test/webhooks/telnyx/tools/book_appointment",
      },
    },
    {
      "timeout_ms": 20000,
      "type": "webhook",
      "webhook": {
        "body_parameters": {
          "properties": {},
          "required": undefined,
          "type": "object",
        },
        "description": "Busca la próxima cita del negocio asociada al número desde el que llama, si el cliente dio consentimiento SMS al reservarla. Devuelve también clientName (el nombre con el que se reservó; puede venir vacío en citas antiguas) — úsalo si el cliente quiere recrear la cita al mismo nombre. Úsala solo si quien llama pide cambiar o cancelar una cita existente y no te ha dado datos concretos.",
        "headers": [
          {
            "name": "X-Alhabla-Call-Control-Id",
            "value": "{{call_control_id}}",
          },
        ],
        "method": "POST",
        "name": "find_my_appointment",
        "url": "https://api.alhabla.test/webhooks/telnyx/tools/find_my_appointment",
      },
    },
    {
      "timeout_ms": 20000,
      "type": "webhook",
      "webhook": {
        "body_parameters": {
          "properties": {
            "bookingId": {
              "description": "El id de la cita devuelto por find_my_appointment.",
              "type": "string",
            },
          },
          "required": [
            "bookingId",
          ],
          "type": "object",
        },
        "description": "Cancela la cita cuyo id devolvió find_my_appointment. Úsala solo tras confirmación explícita del cliente. Para 'modificar' una cita: cancélala con esta tool y reserva la nueva con check_availability + book_appointment.",
        "headers": [
          {
            "name": "X-Alhabla-Call-Control-Id",
            "value": "{{call_control_id}}",
          },
        ],
        "method": "POST",
        "name": "cancel_appointment",
        "url": "https://api.alhabla.test/webhooks/telnyx/tools/cancel_appointment",
      },
    },
    {
      "timeout_ms": 20000,
      "type": "webhook",
      "webhook": {
        "body_parameters": {
          "properties": {
            "clientName": {
              "description": "Nombre del cliente si ya lo sabes, para reservar a su nombre si se libera la hora.",
              "type": "string",
            },
            "durationMinutes": {
              "description": "Duración en minutos de la cita que quería.",
              "type": "number",
            },
            "professionalId": {
              "description": "ID del profesional concreto que pidió, si lo mencionó (opcional).",
              "type": "string",
            },
            "serviceIds": {
              "description": "IDs de los servicios que pidió, si los mencionó (opcional).",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "startDateTime": {
              "description": "La hora exacta que el cliente quería y no estaba disponible, en formato ISO 8601 en hora local del negocio con su offset explícito (nunca UTC).",
              "type": "string",
            },
          },
          "required": [
            "startDateTime",
            "durationMinutes",
          ],
          "type": "object",
        },
        "description": "Guarda el aviso de que el cliente quiere que le escribamos por WhatsApp si se libera la hora que pidió y no estaba disponible. Válido tanto si el cliente se va sin reservar nada más como si reserva otra hora igualmente. Úsala solo cuando lo pida explícitamente y haya dado consentimiento para WhatsApp a este número.",
        "headers": [
          {
            "name": "X-Alhabla-Call-Control-Id",
            "value": "{{call_control_id}}",
          },
        ],
        "method": "POST",
        "name": "notify_when_available",
        "url": "https://api.alhabla.test/webhooks/telnyx/tools/notify_when_available",
      },
    },
    {
      "timeout_ms": 20000,
      "type": "webhook",
      "webhook": {
        "body_parameters": {
          "properties": {
            "dudas_sin_respuesta": {
              "description": "Preguntas del cliente que no pudiste responder porque no tenías esa información (formas de pago, aparcamiento, si hacéis algo…), una por elemento y con sus palabras. No incluyas lo que sí respondiste ni lo que era para el negocio (recados, quejas). Si respondiste a todo, no lo envíes.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "fallo_de_tool": {
              "description": "true si alguna herramienta (disponibilidad, reserva, cancelación) falló o devolvió error durante la llamada.",
              "type": "boolean",
            },
            "motivo_escalada": {
              "description": "Por qué no se resolvió en la llamada. NO_APLICA si se resolvió.",
              "enum": [
                "CLIENTE_LO_PIDIO",
                "FALLO_TECNICO",
                "FUERA_DE_HORARIO",
                "CONSULTA_COMPLEJA",
                "NO_APLICA",
              ],
              "type": "string",
            },
            "recado": {
              "description": "Solo si el cliente dejó un recado explícito o pidió que el negocio le llame. Si no, no lo envíes.",
              "properties": {
                "motivo": {
                  "description": "Qué quiere o qué pregunta, en una o dos frases, con sus palabras.",
                  "type": "string",
                },
                "nombre": {
                  "description": "Nombre que dio el cliente; vacío si no lo dijo.",
                  "type": "string",
                },
                "quiere_que_le_llamen": {
                  "description": "true si pidió que el negocio le devuelva la llamada.",
                  "type": "boolean",
                },
                "telefono": {
                  "description": "Teléfono al que quiere que le llamen, SOLO si el cliente lo dictó o confirmó que le llamen al número desde el que llama. Nunca lo rellenes por tu cuenta.",
                  "type": "string",
                },
              },
              "required": [
                "motivo",
              ],
              "type": "object",
            },
            "resultado": {
              "description": "RESOLVED si el cliente consiguió lo que quería (reservar, consultar, cancelar); FRUSTRATED si se fue molesto o sin solución; NO_ANSWER si nadie habló o colgó enseguida; ESCALATED si hubo que remitirle al negocio; LEAD_CAPTURED si dejó recado o pidió que le llamen.",
              "enum": [
                "RESOLVED",
                "FRUSTRATED",
                "NO_ANSWER",
                "ESCALATED",
                "LEAD_CAPTURED",
              ],
              "type": "string",
            },
            "servicio_pedido": {
              "description": "Nombre del servicio que pidió el cliente, tal como aparece en el catálogo; vacío si no pidió ninguno.",
              "type": "string",
            },
          },
          "required": [
            "resultado",
          ],
          "type": "object",
        },
        "description": "Informe final de la llamada para el negocio. Llámala UNA sola vez, solo cuando la llamada ya ha terminado (post-conversación), nunca durante la conversación. Resume cómo acabó y, si el cliente dejó un recado o pidió que le llamen, inclúyelo en recado.",
        "headers": [
          {
            "name": "X-Alhabla-Call-Control-Id",
            "value": "{{call_control_id}}",
          },
        ],
        "method": "POST",
        "name": "informar_al_negocio",
        "url": "https://api.alhabla.test/webhooks/telnyx/tools/informar_al_negocio",
      },
    },
    {
      "transfer": {
        "from": "+34910000000",
        "targets": [
          {
            "name": "Responsable del negocio",
            "to": "+34600000000",
          },
        ],
        "voicemail_detection": {
          "detection_mode": "premium",
          "on_voicemail_detected": {
            "action": "stop_transfer",
          },
        },
        "warm_transfer_instructions": "Habla en español. En una sola frase, di que eres la recepcionista de Peluquería Ana y que le pasas a un cliente: su nombre si lo dijo y qué quiere. No hagas preguntas ni esperes respuesta.",
      },
      "type": "transfer",
    },
    {
      "hangup": {
        "description": "Cuelga la llamada cuando la conversación haya terminado.",
      },
      "type": "hangup",
    },
  ],
  "transcription": {
    "language": "multi",
    "model": "deepgram/flux",
    "settings": {
      "eager_eot_threshold": 0.4,
      "eot_threshold": 0.8,
      "eot_timeout_ms": 5000,
      "keyterm": "Corte,Laura",
      "numerals": true,
      "smart_format": true,
    },
  },
  "voiceSettings": {
    "background_audio": {
      "type": "predefined_media",
      "value": "office",
      "volume": 0.2,
    },
    "expressive_mode": true,
    "voice": "Telnyx.Ultra.blanca",
  },
}
`;

