# Database
DATABASE_URL=postgresql://user:password@localhost:5432/botbook

# Redis
REDIS_URL=redis://localhost:6379

# Vapi
VAPI_API_KEY=your_vapi_api_key
VAPI_WEBHOOK_SECRET=your_webhook_secret
VAPI_BASE_URL=https://api.vapi.ai

# Retell.ai (orquestador alternativo para cuentas europeas / RGPD)
RETELL_API_KEY=your_retell_api_key
RETELL_BASE_URL=https://api.retellai.com

# Demo web pública de la landing (llamada desde el navegador, vía Retell)
RETELL_DEMO_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_PELUQUERIA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_FISIOTERAPIA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_SALON_UÑAS_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_BARBERIA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_CENTRO_ESTETICA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_MAX_DURATION_SECONDS=60

# AWS S3 / Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET=botbook-recordings
R2_REGION=auto9
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars

# Stripe Billing (sandbox/test values during development)
# Prefer a restricted server key with only the permissions this integration needs.
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_local_webhook_secret
STRIPE_PRICE_INICIO=price_your_inicio_monthly_price
STRIPE_PRICE_PRO=price_your_pro_monthly_price
STRIPE_PRICE_SCALE=price_your_scale_monthly_price
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/auth/google/callback

# Microsoft Outlook Calendar OAuth 2.0
MICROSOFT_CLIENT_ID=your_microsoft_application_client_id
# Use the client secret VALUE shown when the secret is created, not its Secret ID.
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_value
MICROSOFT_REDIRECT_URI=http://localhost:3000/calendar/auth/microsoft/callback

# Google Places API (New)
GOOGLE_PLACES_API_KEY=AIzaSyAhmbwcfR-xOury_P72vV7foZhnSJSboFo

# Google login OAuth 2.0 (use a separate Web application client)
GOOGLE_AUTH_CLIENT_ID=your_google_login_client_id
GOOGLE_AUTH_CLIENT_SECRET=your_google_login_client_secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3001
# Opcional: origen extra permitido por CORS (ej. una URL de ngrok temporal
# para ver el panel desde fuera). No afecta a redirects de OAuth/Stripe.
EXTRA_ALLOWED_ORIGIN=

# Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=SKxxx
TWILIO_API_SECRET=your_api_secret
TWILIO_PHONE_NUMBER_COUNTRY=ES
# Bundle regulatorio de Twilio aprobado para números españoles (BUxxx) —
# obligatorio para poder comprar números en el registro. Ver
# https://www.twilio.com/docs/phone-numbers/regulatory
TWILIO_SPAIN_BUNDLE_SID=BUxxx

#Twilio test crededentials
TWILIO_TEST_ACCOUNT_SID=ACxxx
TWILIO_TEST_AUTH_TOKEN=your_auth_token

# Telnyx (proveedor activo para la compra de números de España — Twilio no
# los vende en autoservicio, ver AGENTS.md)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_SIP_CONNECTION_ID=your_telnyx_sip_connection_id
# Requirement Group de Telnyx aprobado para números locales de España
# (individual) — reutilizado en cada pedido. Ver
# https://developers.telnyx.com/docs/numbers/phone-numbers/requirement-groups
TELNYX_SPAIN_REQUIREMENT_GROUP_ID=your_requirement_group_id

# Retell SIP trunk (SIP Connection de Telnyx apuntando a Retell) —
# configuración de plataforma, única para todos los negocios
RETELL_SIP_TERMINATION_URI=your-connection.sip.telnyx.com
RETELL_SIP_TRUNK_AUTH_USERNAME=your_sip_trunk_username
RETELL_SIP_TRUNK_AUTH_PASSWORD=your_sip_trunk_password
# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
