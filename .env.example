# Database
DATABASE_URL=postgresql://user:password@localhost:5432/alhabla

# Redis
REDIS_URL=redis://localhost:6379

# Vapi
VAPI_API_KEY=your_vapi_api_key
VAPI_WEBHOOK_SECRET=your_webhook_secret
VAPI_BASE_URL=https://api.vapi.ai

# Retell.ai (orquestador alternativo para cuentas europeas / RGPD)
RETELL_API_KEY=your_retell_api_key
RETELL_BASE_URL=https://api.retellai.com

# Demo web pública de la landing (llamada desde el navegador, vía Retell)
RETELL_DEMO_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_PELUQUERIA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_FISIOTERAPIA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_SALON_UÑAS_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_BARBERIA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_CENTRO_ESTETICA_AGENT_ID=your_retell_demo_agent_id
RETELL_DEMO_MAX_DURATION_SECONDS=60

# AWS S3 / Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET=alhabla-recordings
R2_REGION=auto9
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
# Solo para inicializar una base de datos de producción vacía mediante
# POST /auth/register-first-user con la cabecera X-Bootstrap-Secret.
FIRST_USER_BOOTSTRAP_SECRET=generate_a_long_random_one_time_secret

# Stripe Billing (sandbox/test values during development)
# Prefer a restricted server key with only the permissions this integration needs.
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_local_webhook_secret
STRIPE_PRICE_INICIO=price_your_inicio_monthly_price
STRIPE_PRICE_PRO=price_your_pro_monthly_price
STRIPE_PRICE_SCALE=price_your_scale_monthly_price
# Precios recurrentes medidos, con el tramo de minutos incluidos a 0 €.
STRIPE_PRICE_EXTRA_INICIO=price_your_inicio_extra_minutes_price
STRIPE_PRICE_EXTRA_PRO=price_your_pro_extra_minutes_price
STRIPE_PRICE_EXTRA_SCALE=price_your_scale_extra_minutes_price
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/auth/google/callback

# Microsoft Outlook Calendar OAuth 2.0
MICROSOFT_CLIENT_ID=your_microsoft_application_client_id
# Use the client secret VALUE shown when the secret is created, not its Secret ID.
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_value
MICROSOFT_REDIRECT_URI=http://localhost:3000/calendar/auth/microsoft/callback

# Google Places API (New)
GOOGLE_PLACES_API_KEY=AIzaSyAhmbwcfR-xOury_P72vV7foZhnSJSboFo

# Google login OAuth 2.0 (use a separate Web application client)
GOOGLE_AUTH_CLIENT_ID=your_google_login_client_id
GOOGLE_AUTH_CLIENT_SECRET=your_google_login_client_secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3001
# Opcional: origen extra permitido por CORS (ej. una URL de ngrok temporal
# para ver el panel desde fuera). No afecta a redirects de OAuth/Stripe.
EXTRA_ALLOWED_ORIGIN=

# Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=SKxxx
TWILIO_API_SECRET=your_api_secret
TWILIO_PHONE_NUMBER_COUNTRY=ES
# Bundle regulatorio de Twilio aprobado para números españoles (BUxxx) —
# obligatorio para poder comprar números en el registro. Ver
# https://www.twilio.com/docs/phone-numbers/regulatory
TWILIO_SPAIN_BUNDLE_SID=BUxxx

#Twilio test crededentials
TWILIO_TEST_ACCOUNT_SID=ACxxx
TWILIO_TEST_AUTH_TOKEN=your_auth_token

# Telnyx (proveedor activo para la compra de números de España — Twilio no
# los vende en autoservicio, ver AGENTS.md)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_SIP_CONNECTION_ID=your_telnyx_sip_connection_id
# Requirement Group de Telnyx aprobado para números locales de España
# (individual) — reutilizado en cada pedido. Ver
# https://developers.telnyx.com/docs/numbers/phone-numbers/requirement-groups
TELNYX_SPAIN_REQUIREMENT_GROUP_ID=your_requirement_group_id
# Localidad del domicilio acreditado en el Requirement Group (obligatoria si
# el grupo es de tipo "individual" — el número debe ser de esta ciudad).
# Vacío/sin definir = sin filtro de ciudad (grupos de tipo "business").
TELNYX_SPAIN_LOCALITY=Barcelona

# Retell SIP trunk (SIP Connection de Telnyx apuntando a Retell) —
# configuración de plataforma, única para todos los negocios
RETELL_SIP_TERMINATION_URI=your-connection.sip.telnyx.com
RETELL_SIP_TRUNK_AUTH_USERNAME=your_sip_trunk_username
RETELL_SIP_TRUNK_AUTH_PASSWORD=your_sip_trunk_password

# Telnyx AI Assistants (orquestador primario en rollout, ver
# PLAN-TELNYX-ORQUESTADOR.md) — clave pública Ed25519 en base64 para
# verificar la firma de sus webhooks de Call Control (Portal Telnyx >
# Mission Control > Public Key). Distinta de TELNYX_API_KEY (la clave
# privada de la cuenta). Mismo nombre que usa el SDK oficial
# (`new Telnyx({ publicKey })` lo lee de aquí por defecto) — no renombrar.
TELNYX_PUBLIC_KEY=your_telnyx_ed25519_public_key
# off = solo Retell (comportamiento actual). Cualquier otro valor activa la
# creación dual de assistants en createBusinessAgent() — ver
# PLAN-TELNYX-ORQUESTADOR.md Fase 5 para las cohortes previstas
# (development|production-test|new|all); hoy es un simple interruptor.
VOICE_TELNYX_ROLLOUT=off
# Call Control App de plataforma (Fase 4) — se crea una sola vez de forma
# manual y se usa como connection_id de los números en ruta Telnyx primary.
TELNYX_CALL_CONTROL_APP_ID=your_telnyx_call_control_app_id
# IDs de componentes del status page público de Telnyx (statuspage.io,
# separados por comas) que telnyx-health-check vigila para decidir un
# failover automático. Verificado en vivo 2026-09-11: Telnyx NO publica un
# componente específico de "AI Assistants"/"Inference" — decidir qué IDs
# monitorizar (o si el status page es un proxy suficiente) queda pendiente
# de la Fase 0. Vacío = failover automático inactivo (el job no evalúa nada).
TELNYX_STATUS_COMPONENT_IDS=
# Destino del correo de alerta diario de telnyx-reconciler (PLAN-TELNYX-
# ORQUESTADOR.md Fase 6) — assistants borrados a mano en Telnyx, drift de
# nombre o enrutamiento inconsistente. Sin ella, el job solo deja constancia
# en logs.
TELNYX_ALERT_EMAIL=
# Kill switch global del failover automático (plan §7). false/sin definir =
# telnyx-health-check no actúa aunque VOICE_TELNYX_ROLLOUT esté activo.
VOICE_FAILOVER_ENABLED=false
# Alphanumeric Sender ID (ej. "ALHABLA") pendiente de aprobación por Telnyx
# (issue #21) — a diferencia de un número, va directo en el campo `from` del
# envío de SMS, sin depender del número Telnyx de cada negocio ni de que
# ese número esté dado de alta en un Messaging Profile (confirmado con la
# documentación oficial de Telnyx, 2026-09-13). Vacío/sin definir = se sigue
# enviando desde business.telnyxPhoneNumber (hoy bloqueado, ver AGENTS.md).
TELNYX_SMS_SENDER_ID=

# Zoho Mail (correos transaccionales vía API REST, centro de datos .eu) —
# welcome@ y support@ son alias de "enviar como" de la cuenta autenticada.
# ZOHO_REFRESH_TOKEN se obtiene una vez con un flujo OAuth 2.0 manual desde
# Zoho API Console (ver backend/src/lib/zohoMail.ts).
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ACCOUNT_ID=your_zoho_mail_account_id

# Cloud Tasks (solo se usan cuando NODE_ENV=production — en dev/local los
# jobs se ejecutan en línea, sin encolar de verdad, ver lib/cloudTasks.ts)
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=europe-west1
INTERNAL_JOBS_BASE_URL=https://api.alhabla.ai
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=your_invoker_service_account_email
# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
