{
  "shape": "package",
  "projectId": "b0d14166-6e00-4920-a8c4-644a53373e25",
  "entry": "frontend/.ds-src/entry.ts",
  "pkg": "alhabla-ui",
  "globalName": "Alhabla",
  "buildCmd": "node .design-sync/prepare.mjs",
  "srcDir": "src/components",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-src/alhabla.css",
  "docsDir": "../.design-sync/docs",
  "guidelinesGlob": [
    "../DESIGN.md"
  ],
  "provider": {
    "component": "PreviewProviders"
  },
  "componentSrcMap": {
    "BrandMark": "src/components/brand-mark.tsx",
    "RangeSlider": "src/components/range-slider.tsx",
    "BusinessHoursEditor": "src/components/business-hours-editor.tsx",
    "AgentSettingsEditor": "src/components/agent-settings-editor.tsx",
    "GoogleAuthButton": "src/components/google-auth-button.tsx",
    "SettingsSection": "src/components/settings-section.tsx",
    "RecentCalls": "src/components/recent-calls.tsx",
    "OnboardingChecklist": "src/components/onboarding-checklist.tsx",
    "CallDetailModal": "src/components/call-detail-modal.tsx",
    "ParticleField": "src/components/particle-field.tsx",
    "ParticleMouseLayer": "src/components/particle-mouse-layer.tsx",
    "LottieAnimation": "src/components/lottie-animation.tsx"
  },
  "overrides": {
    "ParticleField": {
      "cardMode": "single",
      "primaryStory": "SobreBlanco"
    },
    "CallDetailModal": {
      "cardMode": "single",
      "primaryStory": "Consulta",
      "viewport": "900x800"
    },
    "ParticleMouseLayer": {
      "cardMode": "single",
      "viewport": "900x480"
    }
  },
  "dtsPropsFor": {
    "RecentCalls": "  /** No recibe props: lee las llamadas de useQuery([\"recent-calls\"]). */",
    "OnboardingChecklist": "  /** No recibe props: lee el estado de useQuery([\"onboarding-state\"]). */"
  },
  "readmeHeader": ".design-sync/conventions.md"
}
